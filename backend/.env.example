PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Firebase (Google / GitHub sign-in) — from Firebase console:
# Project Settings > General > Project ID. Public value, not a secret —
# ID tokens are verified against Google's public certs, no service-account key needed.
FIREBASE_PROJECT_ID=

# Job search (Adzuna public jobs API) � free keys at https://developer.adzuna.com/
# ADZUNA_COUNTRY: gb, us, in, au, ca, de, fr, nz, sg, za ...
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Password-reset email over HTTPS (needed on hosts that block SMTP, e.g. Render free).
# Use ONE: Brevo (free 300/day, EMAIL_FROM must be a verified sender) or Resend.
BREVO_API_KEY=
RESEND_API_KEY=

# Optional: job search with India coverage (free key from jooble.org/api/about).
JOOBLE_API_KEY=
